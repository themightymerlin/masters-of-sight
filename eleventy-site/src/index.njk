---
layout: base.njk
title: Masters Of Sight
homepageCss: true
---

<script>
  window.PEOPLE = {{ people | dump | safe }};
  window.SITE_BASE_URL = "{{ '/' | url }}";
</script>
<script type="application/json" id="kg-works-index">{{ worksIndex | dump | replace("<", "\\u003c") | safe }}</script>

<div class="hero">
  <div class="hero-inner">
    <div class="hero-left">
      <p class="hero-sub">A living archive of taste.</p>
      <h1 class="hero-title">Masters<br><em>of</em> <span class="hero-title-sight">Sight</span></h1>
      <p class="hero-sub">{{ people | length }} Masters with more added every week.</p>
    </div>
    <div class="hero-right" id="hero-motw"></div>
  </div>
<a class="hero-credit" href="#" hidden></a>
<script>
(function () {
  var covers = [
    {% for c in heroCovers %}{% for p in people %}{% if p.id == c.masterId %}{ id: "{{ p.id }}", name: {{ p.name | dump | safe }}, src: "{{ c.src }}", pos: "{{ c.position or 'center' }}" },{% endif %}{% endfor %}{% endfor %}
  ];
  var hero = document.querySelector('.hero');
  if (!hero || !covers.length) return;

  var last = null;
  try { last = sessionStorage.getItem('mos-last-cover'); } catch (e) {}
  var pool = covers.filter(function (c) { return c.id !== last; });
  if (!pool.length) pool = covers;
  var pick = pool[Math.floor(Math.random() * pool.length)];
  try { sessionStorage.setItem('mos-last-cover', pick.id); } catch (e) {}
  window.MOS_HERO_COVER = { id: pick.id, name: pick.name };

  var width = window.innerWidth <= 600 ? 'w_1200' : 'w_2400';
  var src = pick.src.replace('/upload/f_auto,q_auto/', '/upload/f_auto,q_auto,' + width + ',c_limit/');
  hero.style.setProperty('--hero-cover', 'url("' + src + '")');
  hero.style.setProperty('--hero-cover-pos', pick.pos);
  hero.classList.add('has-cover');

  var credit = hero.querySelector('.hero-credit');
  if (credit) {
    credit.textContent = '';
    var creditLabel = document.createElement('span');
    creditLabel.className = 'hero-credit-label';
    creditLabel.textContent = 'Cover by';
    var creditName = document.createElement('span');
    creditName.className = 'hero-credit-name';
    creditName.textContent = pick.name + ' \u2197';
    credit.appendChild(creditLabel);
    credit.appendChild(creditName);
    credit.href = window.SITE_BASE_URL + 'masters/' + pick.id + '/';
    credit.hidden = false;
  }

  var nav = document.querySelector('.site-nav');
  if (nav) {
    nav.classList.add('nav-over-cover');
    var update = function () {
      nav.classList.toggle('nav-scrolled', window.scrollY > hero.offsetHeight - nav.offsetHeight);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
})();
</script>
</div>

<div class="filter-bar-wrap">
  <div class="filter-bar">
    <button class="filter-btn active" onclick="filterCards('all', this)">All</button>
    <button class="filter-btn" onclick="filterCards('Cinematographer', this)">Cinematographers</button>
    <button class="filter-btn" onclick="filterCards('Designer', this)">Designers</button>
    <button class="filter-btn" onclick="filterCards('Director', this)">Directors</button>
    <button class="filter-btn" onclick="filterCards('Photographer', this)">Photographers</button>
    <button class="filter-btn" onclick="filterCards('Dream Makers', this)">Dream Makers</button>
    <button class="filter-btn" onclick="filterCards('Editor', this)">Editors</button>
    <button class="filter-btn" onclick="filterCards('Colorist', this)">Colorists</button>
  </div>
</div>

<script>
  (function () {
    var bar = document.querySelector('.filter-bar');
    var wrap = document.querySelector('.filter-bar-wrap');
    if (!bar || !wrap) return;

    function updateFade() {
      var atEnd = bar.scrollLeft >= (bar.scrollWidth - bar.clientWidth - 2);
      wrap.classList.toggle('at-end', atEnd);
    }
    updateFade();
    bar.addEventListener('scroll', updateFade, { passive: true });
    window.addEventListener('resize', updateFade);

    bar.addEventListener('wheel', function (e) {
      if (bar.scrollWidth <= bar.clientWidth) return;
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        e.preventDefault();
        bar.scrollLeft += e.deltaY;
      }
    }, { passive: false });

    if (bar.scrollWidth > bar.clientWidth) {
      setTimeout(function () {
        bar.scrollTo({ left: 48, behavior: 'smooth' });
        setTimeout(function () {
          bar.scrollTo({ left: 0, behavior: 'smooth' });
        }, 500);
      }, 700);
    }
  })();
</script>

<script>
  (function () {
    var bar = document.querySelector('.filter-bar');
    if (!bar) return;

    var EDGE_ZONE = 70;
    var MAX_SPEED = 9;
    var rafId = null;
    var speed = 0;

    function loop() {
      if (speed !== 0) {
        bar.scrollLeft += speed;
      }
      rafId = requestAnimationFrame(loop);
    }

    bar.addEventListener('mousemove', function (e) {
      if (bar.scrollWidth <= bar.clientWidth) { speed = 0; return; }
      var rect = bar.getBoundingClientRect();
      var x = e.clientX - rect.left;
      var distFromRight = rect.width - x;
      var distFromLeft = x;

      if (distFromRight < EDGE_ZONE) {
        speed = MAX_SPEED * (1 - distFromRight / EDGE_ZONE);
      } else if (distFromLeft < EDGE_ZONE) {
        speed = -MAX_SPEED * (1 - distFromLeft / EDGE_ZONE);
      } else {
        speed = 0;
      }
    });

    bar.addEventListener('mouseleave', function () {
      speed = 0;
    });

    rafId = requestAnimationFrame(loop);
  })();
</script>

<div class="search-bar kg-bar" id="search-bar">
  <div class="search-input-wrap">
    <span class="search-icon">⌕</span>
    <div class="kg-wrap" id="kg-wrap">
      <input
        type="text"
        id="search-input"
        class="search-input"
        placeholder="Who shot Interstellar?"
        aria-label="Search the archive"
        autocomplete="off"
        spellcheck="false"
      >
      <div class="kg-ghost" id="kg-ghost" aria-hidden="true">
        <span class="kg-ghost-text" id="kg-ghost-text"></span><span class="kg-caret" id="kg-caret"></span>
      </div>
    </div>
    <button class="search-clear" id="search-clear" onclick="clearSearch()" aria-label="Clear search">✕</button>
  </div>
  <button class="surprise-btn" id="surprise-btn" title="Show me a random master">&#9661;</button>
  <span class="search-count" id="search-count"></span>
</div>

<div class="kg-result" id="kg-result" hidden></div>
<div class="kg-miss" id="kg-miss" hidden></div>

<div class="grid" id="card-grid">
  {% for person in people %}
  <a class="card" href="{{ ('/masters/' ~ person.id ~ '/') | url }}" data-id="{{ person.id }}" data-discipline="{{ person.discipline }}">
    {% set hasImage = person.coverImage and person.coverImage | trim != "" %}
    {% if hasImage %}
    <img class="card-img" src="{{ person.coverImage }}" alt="{{ person.name }}" loading="lazy" style="object-position: {{ person.coverImagePosition or 'center center' }}" onerror="this.style.display='none'; this.nextElementSibling.style.display='none'; this.parentElement.querySelector('.card-placeholder').style.display='flex';">
    <div class="card-overlay"></div>
    {% else %}
    <div class="card-overlay" style="display:none;"></div>
    {% endif %}
    <div class="card-placeholder" style="display:{% if hasImage %}none{% else %}flex{% endif %}; position:absolute; inset:0;">
      <span class="card-placeholder-initials"></span>
    </div>
    <div class="card-info">
      <p class="card-discipline">{{ person.discipline | displayDiscipline(person.entityType) }}</p>
      <p class="card-name">{% if person.cardName %}{{ person.cardName | safe }}{% else %}{{ person.name }}{% endif %}</p>
    </div>
    <div class="card-arrow">↗</div>
  </a>
  {% endfor %}
</div>

<footer>
  <div style="text-align: center; line-height: 1.9;">
    <div class="footer-copy">Masters Of Sight™  est. 2026 — A living archive of taste.</div>
    <div class="footer-copy" id="footer-count"></div>
  </div>
</footer>

<script>
(function () {
  var FEATURED_MASTER_OVERRIDE = null;
  var _activeSearch = '';
  var _activeDiscipline = 'all';

  function getInitials(name) {
    return name.split(' ').map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase();
  }

  function displayDiscipline(d, entityType) {
    if (Array.isArray(d)) return d.map(function (x) { return displayDiscipline(x, entityType); }).join(' / ');
    if (entityType === 'duo' && d === 'Director') return 'Directors';
    return d === 'Dream Makers' ? 'Dream Maker' : d;
  }

  function formatCardName(name) {
    var parts = name.trim().split(' ');
    if (parts.length === 1) return name;
    var last = parts[parts.length - 1];
    var first = parts.slice(0, -1).join(' ');
    return first + '<br>' + last;
  }

  function isNewMaster(person) {
    if (!person.added) return false;
    var parts = person.added.split('-').map(Number);
    var year = parts[0], month = parts[1], day = parts[2];
    var added = new Date(year, month - 1, day || 1);
    var cutoff = new Date();
    cutoff.setDate(cutoff.getDate() - 14);
    return added >= cutoff;
  }

  function buildCard(person) {
    var card = document.createElement('a');
    card.className = 'card';
    card.href = window.SITE_BASE_URL + 'masters/' + person.id + '/' + (_activeDiscipline ? '?from=' + _activeDiscipline : '');
    card.dataset.discipline = person.discipline;
    card.dataset.id = person.id;

    var isNew = isNewMaster(person);
    var hasImage = person.coverImage && person.coverImage.trim() !== '';

    card.innerHTML =
      (isNew ? '<span class="card-new-badge">New</span>' : '') +
      (hasImage
        ? '<img class="card-img" src="' + person.coverImage + '" alt="' + person.name + '" loading="lazy" style="object-position: ' + (person.coverImagePosition || 'center center') + '" onerror="this.style.display=\'none\'; this.nextElementSibling.style.display=\'none\'; this.parentElement.querySelector(\'.card-placeholder\').style.display=\'flex\';">' +
          '<div class="card-overlay"></div>'
        : '<div class="card-overlay" style="display:none;"></div>') +
      '<div class="card-placeholder" style="display:' + (hasImage ? 'none' : 'flex') + '; position:absolute; inset:0;">' +
        '<span class="card-placeholder-initials">' + getInitials(person.name) + '</span>' +
      '</div>' +
      '<div class="card-info">' +
        '<p class="card-discipline">' + displayDiscipline(person.discipline, person.entityType) + '</p>' +
        '<p class="card-name">' + (person.cardName || formatCardName(person.name)) + '</p>' +
      '</div>' +
      '<div class="card-arrow">↗</div>';
    return card;
  }

  function buildGallery(people) {
    var grid = document.getElementById('card-grid');
    grid.innerHTML = '';
    people.forEach(function (person) { grid.appendChild(buildCard(person)); });
  }

  function runFilter() {
    var q = _activeSearch.toLowerCase().trim();
    var d = _activeDiscipline;
    var filtered = window.PEOPLE.filter(function (p) {
      var disciplineMatch = d === 'all' || (Array.isArray(p.discipline) ? p.discipline.includes(d) : p.discipline === d);
      if (!disciplineMatch) return false;
      if (!q) return true;
      return (
        p.name.toLowerCase().includes(q) ||
        (Array.isArray(p.discipline) ? p.discipline.join(' ').toLowerCase() : p.discipline.toLowerCase()).includes(q) ||
        (p.style || '').toLowerCase().includes(q) ||
        (p.bio || '').toLowerCase().includes(q) ||
        (p.nationality || '').toLowerCase().includes(q)
      );
    });
    buildGallery(filtered);
    var countEl = document.getElementById('search-count');
    if (countEl) countEl.textContent = q ? (filtered.length + ' result' + (filtered.length !== 1 ? 's' : '')) : '';
  }

  window.filterCards = function (discipline, btn) {
    document.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    _activeDiscipline = discipline;
    runFilter();
    history.replaceState(null, '', discipline ? '?discipline=' + discipline : window.location.pathname);
  };

  window.clearSearch = function () {
    var input = document.getElementById('search-input');
    if (input) input.value = '';
    _activeSearch = '';
    document.getElementById('search-clear').classList.remove('visible');
    document.getElementById('search-count').textContent = '';
    runFilter();
    if (window.KG && window.KG.handleInput) window.KG.handleInput('', '');
  };

  function showSurprise() {
    var q = _activeSearch.toLowerCase().trim();
    var d = _activeDiscipline;
    var pool = window.PEOPLE.filter(function (p) {
      var disciplineMatch = d === 'all' || (Array.isArray(p.discipline) ? p.discipline.includes(d) : p.discipline === d);
      if (!disciplineMatch) return false;
      if (!q) return true;
      return (
        p.name.toLowerCase().includes(q) ||
        (Array.isArray(p.discipline) ? p.discipline.join(' ').toLowerCase() : p.discipline.toLowerCase()).includes(q) ||
        (p.style || '').toLowerCase().includes(q)
      );
    });
    if (!pool.length) return;
    var pick = pool[Math.floor(Math.random() * pool.length)];
    window.location.href = window.SITE_BASE_URL + 'masters/' + pick.id + '/';
  }

  function getISOWeekSeed(date) {
    var d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
    var dayNum = (d.getUTCDay() + 6) % 7;
    d.setUTCDate(d.getUTCDate() - dayNum + 3);
    var firstThursday = new Date(Date.UTC(d.getUTCFullYear(), 0, 4));
    var firstDayNum = (firstThursday.getUTCDay() + 6) % 7;
    firstThursday.setUTCDate(firstThursday.getUTCDate() - firstDayNum + 3);
    var weekNum = 1 + Math.round((d - firstThursday) / (7 * 24 * 60 * 60 * 1000));
    return d.getUTCFullYear() + '-W' + weekNum;
  }

  function getISOWeekMonday(date) {
    var d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
    var dayNum = (d.getUTCDay() + 6) % 7;
    d.setUTCDate(d.getUTCDate() - dayNum);
    return d;
  }

  function hashString(str) {
    var hash = 0;
    for (var i = 0; i < str.length; i++) {
      hash = (Math.imul(31, hash) + str.charCodeAt(i)) | 0;
    }
    return hash;
  }

  function pickFeaturedForSeed(weekSeed, excludeIds, weekStartDate) {
    var best = null;
    var bestHash = -Infinity;
    window.PEOPLE.forEach(function (p) {
      if (excludeIds.includes(p.id)) return;
      if (p.added && weekStartDate) {
        var parts = p.added.split('-').map(Number);
        var year = parts[0], month = parts[1], day = parts[2];
        var addedDate = new Date(Date.UTC(year, month - 1, day || 1));
        if (addedDate >= weekStartDate) return;
      }
      var h = hashString(weekSeed + p.id);
      if (h > bestHash) { bestHash = h; best = p; }
    });
    return best;
  }

  function renderMasterOfTheWeek() {
    var el = document.getElementById('hero-motw');
    if (!el) return;

    var featured;
    if (FEATURED_MASTER_OVERRIDE) {
      featured = window.PEOPLE.find(function (p) { return p.id === FEATURED_MASTER_OVERRIDE; });
    }

    if (!featured) {
      var now = new Date();
      var currentSeed = getISOWeekSeed(now);
      var currentWeekStart = getISOWeekMonday(now);
      var NO_REPEAT_WEEKS = 3;
      var excludeIds = [];
      for (var i = 1; i <= NO_REPEAT_WEEKS; i++) {
        var pastDate = new Date(now.getTime() - i * 7 * 24 * 60 * 60 * 1000);
        var pastSeed = getISOWeekSeed(pastDate);
        var pastWeekStart = getISOWeekMonday(pastDate);
        var pastPick = pickFeaturedForSeed(pastSeed, [], pastWeekStart);
        if (pastPick) excludeIds.push(pastPick.id);
      }
      featured = pickFeaturedForSeed(currentSeed, excludeIds, currentWeekStart) || pickFeaturedForSeed(currentSeed, [], currentWeekStart);
    }

    if (!featured) return;
    window.MOS_MOTW = { id: featured.id, name: featured.name };

    var discipline = displayDiscipline(featured.discipline, featured.entityType);
    var total = window.PEOPLE.length;
    var disciplines = new Set(window.PEOPLE.flatMap(function (p) { return Array.isArray(p.discipline) ? p.discipline : [p.discipline]; })).size;

    el.innerHTML =
      '<p class="hero-stat">' + total + ' Masters. ' + disciplines + ' Disciplines.</p>' +
      '<div class="hero-motw-rule"></div>' +
      '<a class="hero-motw-block" href="' + window.SITE_BASE_URL + 'masters/' + featured.id + '/">' +
        '<p class="hero-motw-label">A Master Worth Knowing</p>' +
        '<p class="hero-motw-name">' + featured.name + '</p>' +
        '<p class="hero-motw-discipline">' + discipline + '</p>' +
      '</a>';
  }

  function hydrateInitialCards() {
    document.querySelectorAll('#card-grid .card').forEach(function (card) {
      var person = window.PEOPLE.find(function (p) { return p.id === card.dataset.id; });
      if (!person) return;

      var nameEl = card.querySelector('.card-name');
      if (nameEl && !person.cardName) {
        nameEl.innerHTML = formatCardName(person.name);
      }

      var initialsEl = card.querySelector('.card-placeholder-initials');
      if (initialsEl) {
        initialsEl.textContent = getInitials(person.name);
      }

      if (isNewMaster(person) && !card.querySelector('.card-new-badge')) {
        var badge = document.createElement('span');
        badge.className = 'card-new-badge';
        badge.textContent = 'New';
        card.prepend(badge);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    hydrateInitialCards();
    renderMasterOfTheWeek();

    var disciplineParam = new URLSearchParams(window.location.search).get('discipline');
    if (disciplineParam) {
      var matchingBtn = Array.prototype.find.call(document.querySelectorAll('.filter-btn'), function (b) {
        var onclickAttr = b.getAttribute('onclick') || '';
        return onclickAttr.indexOf("'" + disciplineParam + "'") !== -1;
      });
      if (matchingBtn) filterCards(disciplineParam, matchingBtn);
    }

    var footerCount = document.getElementById('footer-count');
    if (footerCount) footerCount.textContent = window.PEOPLE.length + ' visual architects and counting.';

    var surpriseBtn = document.getElementById('surprise-btn');
    if (surpriseBtn) surpriseBtn.addEventListener('click', showSurprise);

    var searchInput = document.getElementById('search-input');
    if (searchInput) {
      searchInput.addEventListener('input', function (e) {
        var raw = e.target.value;
        var cleaned = (window.KG && window.KG.normalizeQuery) ? window.KG.normalizeQuery(raw) : raw.toLowerCase().trim();
        _activeSearch = cleaned;
        var clearBtn = document.getElementById('search-clear');
        if (clearBtn) clearBtn.classList.toggle('visible', raw.length > 0);
        runFilter();
        if (window.KG && window.KG.handleInput) window.KG.handleInput(raw, cleaned);
      });
    }
  });
})();
</script>
<script>
(function () {
  function addNavMotw() {
    var m = window.MOS_MOTW;
    var nav = document.querySelector('.site-nav');
    if (!m || !nav || nav.querySelector('.nav-motw')) return;
    var wrap = document.createElement('div');
    wrap.className = 'nav-motw';
    var label = document.createElement('span');
    label.className = 'nav-motw-label';
    label.textContent = 'Master of the Week';
    var link = document.createElement('a');
    link.className = 'nav-motw-name';
    link.href = window.SITE_BASE_URL + 'masters/' + m.id + '/';
    link.textContent = m.name;
    wrap.appendChild(label);
    wrap.appendChild(link);
    nav.appendChild(wrap);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', addNavMotw);
  } else {
    addNavMotw();
  }
})();
</script>
<script>
(function () {
  var WORKS_INDEX = [];
  try {
    var rawEl = document.getElementById('kg-works-index');
    WORKS_INDEX = rawEl ? JSON.parse(rawEl.textContent) : [];
  } catch (e) { WORKS_INDEX = []; }

  var WORKS_BY_ID = {};
  WORKS_INDEX.forEach(function (p) { WORKS_BY_ID[p.id] = p; });

  var KG_LINES = [
    "Who shot Interstellar?",
    "Who directed Terminator 2?",
    "Who created Death Stranding?",
    "Who directed The Iron Giant?",
    "Who shot Nope?",
    "Who directed Aliens?"
  ];

  var PHRASE_TABLE = [
    { phrase: 'who shot', mode: 'title', disciplines: ['Cinematographer', 'Photographer'], verbWord: 'shot' },
    { phrase: 'who directed', mode: 'title', disciplines: ['Director'], verbWord: 'directed' },
    { phrase: 'who made', mode: 'title', disciplines: ['Dream Makers', 'Dream Maker', 'Designer'], verbWord: 'made' },
    { phrase: 'who created', mode: 'title', disciplines: ['Dream Makers', 'Dream Maker', 'Designer'], verbWord: 'created' },
    { phrase: 'who filmed', mode: 'title', disciplines: ['Cinematographer', 'Photographer'], verbWord: 'filmed' },
    { phrase: 'who photographed', mode: 'title', disciplines: ['Cinematographer', 'Photographer'], verbWord: 'photographed' },
    { phrase: 'who edited', mode: 'title', disciplines: ['Editor'], verbWord: 'edited' },
    { phrase: 'who cut', mode: 'title', disciplines: ['Editor'], verbWord: 'cut' },
    { phrase: 'who graded', mode: 'title', disciplines: ['Colorist'], verbWord: 'graded' },
    { phrase: 'who colored', mode: 'title', disciplines: ['Colorist'], verbWord: 'colored' },
    { phrase: 'who designed', mode: 'title', disciplines: ['Dream Makers', 'Dream Maker', 'Designer'], verbWord: 'designed' },
    { phrase: 'who did', mode: 'title', disciplines: null, verbWord: null },
    { phrase: 'who is behind', mode: 'title', disciplines: null, verbWord: null },
    { phrase: 'whos behind', mode: 'title', disciplines: null, verbWord: null },
    { phrase: 'who was behind', mode: 'title', disciplines: null, verbWord: null },
    { phrase: 'who is', mode: 'name', disciplines: null, verbWord: null },
    { phrase: 'whos', mode: 'name', disciplines: null, verbWord: null }
  ].sort(function (a, b) { return b.phrase.length - a.phrase.length; });

  var FILLER_PHRASES = [
    'the opening credits for', 'the cinematography for', 'the title sequence for', 'the opening titles for',
    'the title sequence of', 'the cinematography of', 'the photography for', 'the credits for',
    'the posters for', 'the key art for', 'the titles for', 'the poster for', 'the colour for',
    'the grade for', 'the color for', 'the titles of', 'the edit for', 'the edit of'
  ].sort(function (a, b) { return b.length - a.length; });

  function stripYear(title) {
    return (title || '').replace(/\s*\(\d{4}[^)]*\)\s*$/, '').trim();
  }

  function normalizeCore(str) {
    var s = (str || '').toLowerCase();
    s = s.replace(/\(\d{4}[^)]*\)/g, ' ');
    s = s.replace(/[^\w\s]/g, ' ');
    s = s.replace(/\s+/g, ' ').trim();
    return s;
  }

  function normalizeName(str) {
    return normalizeCore(str);
  }

  function stripLeadingThe(s) {
    return s.indexOf('the ') === 0 ? s.slice(4).trim() : s;
  }

  function matchLeadingEntry(core) {
    for (var i = 0; i < PHRASE_TABLE.length; i++) {
      var e = PHRASE_TABLE[i];
      if (core === e.phrase) return { entry: e, remainder: '' };
      if (core.indexOf(e.phrase + ' ') === 0) return { entry: e, remainder: core.slice(e.phrase.length).trim() };
    }
    return null;
  }

  function stripLeadingFillerPhrase(s) {
    for (var i = 0; i < FILLER_PHRASES.length; i++) {
      var p = FILLER_PHRASES[i];
      if (s === p) return '';
      if (s.indexOf(p + ' ') === 0) return s.slice(p.length).trim();
    }
    return s;
  }

  function detectFillerDiscipline(core) {
    if (core.indexOf('title sequence') !== -1 || core.indexOf('opening credits') !== -1 || core.indexOf('titles') !== -1) {
      return { disciplines: ['Designer'], verbWord: 'designed the titles for' };
    }
    if (core.indexOf('key art') !== -1) {
      return { disciplines: ['Designer'], verbWord: 'designed the key art for' };
    }
    if (core.indexOf('poster') !== -1) {
      return { disciplines: ['Designer'], verbWord: 'designed the poster for' };
    }
    return null;
  }

  function parseQuery(raw) {
    var core = normalizeCore(raw);
    var match = matchLeadingEntry(core);
    var mode = 'title';
    var disciplines = null;
    var verbWord = null;
    var remainder = core;

    if (match) {
      mode = match.entry.mode;
      disciplines = match.entry.disciplines;
      verbWord = match.entry.verbWord;
      remainder = match.remainder;
    }

    if (mode === 'name') {
      return { mode: 'name', cleaned: remainder, disciplines: null, verbWord: null };
    }

    var fillerDiscipline = detectFillerDiscipline(core);
    if (fillerDiscipline) {
      disciplines = fillerDiscipline.disciplines;
      verbWord = fillerDiscipline.verbWord;
    }

    remainder = stripLeadingFillerPhrase(remainder);
    remainder = stripLeadingThe(remainder);

    return { mode: 'title', cleaned: remainder, disciplines: disciplines, verbWord: verbWord };
  }

  function normalizeQuery(str) {
    return parseQuery(str).cleaned;
  }

  function normalizeTitle(str) {
    var s = normalizeCore(str);
    s = stripLeadingThe(s);
    return s;
  }

  function displayDiscipline(d, entityType) {
    if (Array.isArray(d)) return d.map(function (x) { return displayDiscipline(x, entityType); }).join(' / ');
    if (entityType === 'duo' && d === 'Director') return 'Directors';
    return d === 'Dream Makers' ? 'Dream Maker' : d;
  }

  function verbForDiscipline(discipline) {
    var d = Array.isArray(discipline) ? discipline[0] : discipline;
    switch (d) {
      case 'Cinematographer':
      case 'Photographer': return 'Who shot';
      case 'Director': return 'Who directed';
      case 'Dream Makers':
      case 'Designer': return 'Who created';
      case 'Editor': return 'Who cut';
      case 'Colorist': return 'Who graded';
      default: return null;
    }
  }

  function buildCoverLine() {
    var cover = window.MOS_HERO_COVER;
    if (!cover || !cover.id) return null;
    var person = WORKS_BY_ID[cover.id];
    if (!person || !person.works || !person.works.length) return null;
    var verb = verbForDiscipline(person.discipline);
    if (!verb) return null;
    var title = stripYear(person.works[0].title);
    if (!title) return null;
    return verb + ' ' + title + '?';
  }

  var wrap = document.getElementById('kg-wrap');
  var input = document.getElementById('search-input');
  var ghost = document.getElementById('kg-ghost');
  var ghostText = document.getElementById('kg-ghost-text');
  var resultEl = document.getElementById('kg-result');
  var missEl = document.getElementById('kg-miss');

  if (!wrap || !input || !ghost || !ghostText) return;

  var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var lines = KG_LINES.slice();
  var coverLine = buildCoverLine();
  if (coverLine) lines.unshift(coverLine);
  if (!lines.length) lines = ['Search the archive'];

  var lineIndex = 0;
  var charIndex = 0;
  var deleting = false;
  var timer = null;
  var ghostPaused = false;

  function randTypeDelay() {
    return 75 + Math.random() * (130 - 75);
  }

  function tick() {
    if (ghostPaused) { timer = null; return; }
    var line = lines[lineIndex];
    if (!deleting) {
      charIndex++;
      ghostText.textContent = line.slice(0, charIndex);
      if (charIndex >= line.length) {
        timer = setTimeout(function () { deleting = true; tick(); }, 1800);
        return;
      }
      timer = setTimeout(tick, randTypeDelay());
    } else {
      charIndex--;
      ghostText.textContent = line.slice(0, Math.max(charIndex, 0));
      if (charIndex <= 0) {
        deleting = false;
        lineIndex = (lineIndex + 1) % lines.length;
        timer = setTimeout(tick, 500);
        return;
      }
      timer = setTimeout(tick, 38);
    }
  }

  function startTyping() {
    if (reducedMotion) {
      ghostText.textContent = lines[0];
      return;
    }
    if (timer) return;
    tick();
  }

  function stopTyping() {
    if (timer) { clearTimeout(timer); timer = null; }
  }

  function updateGhostState() {
    var isFocused = document.activeElement === input;
    var hasText = input.value.length > 0;
    if (isFocused || hasText) {
      if (!ghostPaused) {
        ghostPaused = true;
        stopTyping();
        wrap.classList.add('kg-ghost-hidden');
      }
    } else {
      if (ghostPaused) {
        ghostPaused = false;
        wrap.classList.remove('kg-ghost-hidden');
        startTyping();
      }
    }
  }

  input.addEventListener('focus', updateGhostState);
  input.addEventListener('blur', updateGhostState);

  function personMatchesVerb(discipline, verbDisciplines) {
    if (!verbDisciplines) return false;
    var list = Array.isArray(discipline) ? discipline : [discipline];
    return list.some(function (d) { return verbDisciplines.indexOf(d) !== -1; });
  }

  function collectExactMatches(cleaned) {
    if (!cleaned) return [];
    var exact = [];
    WORKS_INDEX.forEach(function (p) {
      (p.works || []).forEach(function (w) {
        if (normalizeTitle(w.title) === cleaned) exact.push({ person: p, title: w.title, desc: w.desc, source: 'works' });
      });
      (p.alsoWorkedOn || []).forEach(function (title) {
        if (normalizeTitle(title) === cleaned) exact.push({ person: p, title: title, desc: null, source: 'also' });
      });
    });
    return exact;
  }

  function collectPrefixMatches(cleaned) {
    if (!cleaned || cleaned.length < 3) return [];
    var prefix = [];
    WORKS_INDEX.forEach(function (p) {
      (p.works || []).forEach(function (w) {
        if (normalizeTitle(w.title).indexOf(cleaned) === 0) prefix.push({ person: p, title: w.title, desc: w.desc, source: 'works' });
      });
      (p.alsoWorkedOn || []).forEach(function (title) {
        if (normalizeTitle(title).indexOf(cleaned) === 0) prefix.push({ person: p, title: title, desc: null, source: 'also' });
      });
    });
    return prefix;
  }

  function dedupeKeepingWorks(matches) {
    var order = [];
    var byPerson = {};
    matches.forEach(function (m) {
      var existing = byPerson[m.person.id];
      if (!existing) {
        byPerson[m.person.id] = m;
        order.push(m.person.id);
      } else if (existing.source === 'also' && m.source === 'works') {
        byPerson[m.person.id] = m;
      }
    });
    return order.map(function (id) { return byPerson[id]; });
  }

  function rankGroup(matches, verbDisciplines) {
    return matches
      .map(function (m, i) { return { m: m, i: i }; })
      .sort(function (a, b) {
        var av = personMatchesVerb(a.m.person.discipline, verbDisciplines) ? 0 : 1;
        var bv = personMatchesVerb(b.m.person.discipline, verbDisciplines) ? 0 : 1;
        if (av !== bv) return av - bv;
        var asrc = a.m.source === 'works' ? 0 : 1;
        var bsrc = b.m.source === 'works' ? 0 : 1;
        if (asrc !== bsrc) return asrc - bsrc;
        return a.i - b.i;
      })
      .map(function (x) { return x.m; });
  }

  function toMatchShape(list) {
    return list.slice(0, 4).map(function (m) {
      return { person: m.person, work: { title: m.title, desc: m.desc } };
    });
  }

  function findWorkMatches(cleaned, verbDisciplines) {
    var exact = collectExactMatches(cleaned);

    if (exact.length) {
      var exactHasVerb = !!verbDisciplines && exact.some(function (m) {
        return personMatchesVerb(m.person.discipline, verbDisciplines);
      });

      if (!verbDisciplines || exactHasVerb) {
        return toMatchShape(dedupeKeepingWorks(rankGroup(exact, verbDisciplines)));
      }

      var prefix = collectPrefixMatches(cleaned);
      var prefixVerbMatches = prefix.filter(function (m) {
        return personMatchesVerb(m.person.discipline, verbDisciplines);
      });

      if (prefixVerbMatches.length) {
        var leadGroup = dedupeKeepingWorks(rankGroup(prefixVerbMatches, verbDisciplines));
        var leadIds = {};
        leadGroup.forEach(function (m) { leadIds[m.person.id] = true; });
        var followGroup = dedupeKeepingWorks(rankGroup(exact, verbDisciplines)).filter(function (m) {
          return !leadIds[m.person.id];
        });
        return toMatchShape(leadGroup.concat(followGroup));
      }

      return toMatchShape(dedupeKeepingWorks(rankGroup(exact, verbDisciplines)));
    }

    var prefixFallback = collectPrefixMatches(cleaned);
    if (!prefixFallback.length) return [];
    return toMatchShape(dedupeKeepingWorks(rankGroup(prefixFallback, verbDisciplines)));
  }

  function findNameMatches(remainder) {
    if (!remainder) return [];
    var pool = window.PEOPLE || [];
    var exact = pool.filter(function (p) { return normalizeName(p.name) === remainder; });
    if (exact.length) return exact;
    if (remainder.length < 3) return [];
    return pool.filter(function (p) {
      var norm = normalizeName(p.name);
      if (norm.indexOf(remainder) === 0) return true;
      return norm.split(' ').some(function (w) { return w.indexOf(remainder) === 0; });
    });
  }

  function escapeHtml(str) {
    return (str || '').replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function dedupeByPersonId(matches) {
    var seen = {};
    var list = [];
    matches.forEach(function (m) {
      if (!seen[m.person.id]) {
        seen[m.person.id] = true;
        list.push(m);
      }
    });
    return list;
  }

  function buildMasterBlocksHtml(list) {
    var html = '';
    list.forEach(function (m) {
      var descLine = m.work.desc
        ? '<p class="kg-result-desc">' + escapeHtml(m.work.desc) + '</p>'
        : '<p class="kg-result-discipline">' + escapeHtml('Worked on ' + stripYear(m.work.title)) + '</p>';
      html +=
        '<div class="kg-result-master">' +
          '<a class="kg-result-name" href="' + window.SITE_BASE_URL + 'masters/' + m.person.id + '/">' + escapeHtml(m.person.name) + '</a>' +
          '<p class="kg-result-discipline">' + escapeHtml(displayDiscipline(m.person.discipline)) + '</p>' +
          descLine +
        '</div>';
    });
    return html;
  }

  function buildKeepGoingHtml(relatedIds) {
    var related = (relatedIds || [])
      .map(function (id) { return WORKS_BY_ID[id]; })
      .filter(Boolean)
      .slice(0, 3);
    if (!related.length) return '';
    var html = '<div class="kg-result-keepgoing"><span class="kg-result-keepgoing-label">Follow the thread</span>';
    related.forEach(function (r) {
      html += '<a class="kg-result-keepgoing-link" href="' + window.SITE_BASE_URL + 'masters/' + r.id + '/">' + escapeHtml(r.name) + '</a>';
    });
    html += '</div>';
    return html;
  }

  function renderResultPanel(matches) {
    var list = dedupeByPersonId(matches);
    var titleClean = stripYear(matches[0].work.title);
    var eyebrow = 'The eye' + (list.length > 1 ? 's' : '') + ' behind ' + titleClean;

    var html = '<p class="kg-result-eyebrow">' + escapeHtml(eyebrow) + '</p>';
    html += buildMasterBlocksHtml(list);
    html += buildKeepGoingHtml(list[0].person.related);

    resultEl.innerHTML = html;
    resultEl.hidden = false;
  }

  function renderStrictRoleMissPanel(matches, verbWord) {
    var list = dedupeByPersonId(matches);
    var titleClean = stripYear(matches[0].work.title);
    var message = 'Whoever ' + verbWord + ' ' + titleClean + " isn't in the archive yet.";

    var html =
      '<p class="kg-miss-title">' + escapeHtml(message) + '</p>' +
      '<p class="kg-result-eyebrow">' + escapeHtml('These Masters worked on it') + '</p>';
    html += buildMasterBlocksHtml(list);
    html += buildKeepGoingHtml(list[0].person.related);

    resultEl.innerHTML = html;
    resultEl.hidden = false;
  }

  function firstSentence(text) {
    var m = (text || '').match(/^[\s\S]*?[.!?](?=\s[A-Z]|\s*$)/);
    return m ? m[0].trim() : (text || '').trim();
  }

  function renderNamePanel(people) {
    var list = people.slice(0, 2);
    var html = '<p class="kg-result-eyebrow">' + escapeHtml('Master Of Sight') + '</p>';
    list.forEach(function (p) {
      html +=
        '<div class="kg-result-master">' +
          '<a class="kg-result-name" href="' + window.SITE_BASE_URL + 'masters/' + p.id + '/">' + escapeHtml(p.name) + '</a>' +
          '<p class="kg-result-discipline">' + escapeHtml(displayDiscipline(p.discipline)) + '</p>' +
          '<p class="kg-result-desc">' + escapeHtml(firstSentence(p.bio)) + '</p>' +
        '</div>';
    });
    html += buildKeepGoingHtml(list[0].related);

    resultEl.innerHTML = html;
    resultEl.hidden = false;
  }

  function hideResultPanel() {
    resultEl.hidden = true;
    resultEl.innerHTML = '';
  }

  function pickRandomMaster() {
    var pool = window.PEOPLE || [];
    if (!pool.length) return null;
    return pool[Math.floor(Math.random() * pool.length)];
  }

  function renderMissPanel() {
    var pick = pickRandomMaster();
    if (!pick) { hideMissPanel(); return; }
    missEl.innerHTML =
      '<p class="kg-miss-title">Not in the archive yet.</p>' +
      '<p class="kg-miss-sub">Here’s someone worth your time instead: ' +
        '<a class="kg-miss-link" href="' + window.SITE_BASE_URL + 'masters/' + pick.id + '/">' + escapeHtml(pick.name) + '</a></p>';
    missEl.hidden = false;
  }

  function hideMissPanel() {
    missEl.hidden = true;
    missEl.innerHTML = '';
  }

  function getInitials(name) {
    return name.split(' ').map(function (w) { return w[0]; }).join('').slice(0, 2).toUpperCase();
  }

  function formatCardName(name) {
    var parts = name.trim().split(' ');
    if (parts.length === 1) return name;
    var last = parts[parts.length - 1];
    var first = parts.slice(0, -1).join(' ');
    return first + '<br>' + last;
  }

  function buildOverrideCard(person) {
    var card = document.createElement('a');
    card.className = 'card';
    card.href = window.SITE_BASE_URL + 'masters/' + person.id + '/';
    card.dataset.discipline = person.discipline;
    card.dataset.id = person.id;

    var hasImage = person.coverImage && person.coverImage.trim() !== '';

    card.innerHTML =
      (hasImage
        ? '<img class="card-img" src="' + person.coverImage + '" alt="' + person.name + '" loading="lazy" style="object-position: ' + (person.coverImagePosition || 'center center') + '">' +
          '<div class="card-overlay"></div>'
        : '<div class="card-overlay" style="display:none;"></div>') +
      '<div class="card-placeholder" style="display:' + (hasImage ? 'none' : 'flex') + '; position:absolute; inset:0;">' +
        '<span class="card-placeholder-initials">' + getInitials(person.name) + '</span>' +
      '</div>' +
      '<div class="card-info">' +
        '<p class="card-discipline">' + displayDiscipline(person.discipline, person.entityType) + '</p>' +
        '<p class="card-name">' + (person.cardName || formatCardName(person.name)) + '</p>' +
      '</div>' +
      '<div class="card-arrow">↗</div>';
    return card;
  }

  function overrideGrid(matches) {
    var grid = document.getElementById('card-grid');
    if (!grid) return;
    var seen = {};
    var people = [];
    matches.forEach(function (m) {
      if (!seen[m.person.id]) {
        seen[m.person.id] = true;
        var full = (window.PEOPLE || []).find(function (p) { return p.id === m.person.id; });
        if (full) people.push(full);
      }
    });
    grid.innerHTML = '';
    people.forEach(function (p) { grid.appendChild(buildOverrideCard(p)); });
  }

  function showMissOrHide(cleaned) {
    hideResultPanel();
    if (cleaned.length >= 3) {
      var grid = document.getElementById('card-grid');
      var gridEmpty = grid ? grid.children.length === 0 : false;
      if (gridEmpty) {
        renderMissPanel();
      } else {
        hideMissPanel();
      }
    } else {
      hideMissPanel();
    }
  }

  function handleInput(raw, cleaned) {
    if (!cleaned) {
      hideResultPanel();
      hideMissPanel();
      updateGhostState();
      return;
    }

    var parsed = parseQuery(raw);

    if (parsed.mode === 'name') {
      var nameMatches = findNameMatches(parsed.cleaned);
      if (nameMatches.length) {
        renderNamePanel(nameMatches);
        hideMissPanel();
        overrideGrid(nameMatches.map(function (p) { return { person: p }; }));
      } else {
        showMissOrHide(cleaned);
      }
      updateGhostState();
      return;
    }

    var matches = findWorkMatches(cleaned, parsed.disciplines);
    if (matches.length) {
      var hasVerbMatch = matches.some(function (m) {
        return personMatchesVerb(m.person.discipline, parsed.disciplines);
      });
      if (parsed.disciplines && !hasVerbMatch) {
        renderStrictRoleMissPanel(matches, parsed.verbWord);
      } else {
        renderResultPanel(matches);
      }
      hideMissPanel();
      overrideGrid(matches);
    } else {
      showMissOrHide(cleaned);
    }
    updateGhostState();
  }

  window.KG = {
    normalizeQuery: normalizeQuery,
    handleInput: handleInput
  };

  function init() {
    input.setAttribute('placeholder', '');
    updateGhostState();
    if (!input.value) startTyping();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
