<!doctype html>
<html lang="en">
<head>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-E7GH6KG00B"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-E7GH6KG00B');
</script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@900&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/profile.css' | url }}?v={{ buildVersion }}">
{% if homepageCss %}<link rel="stylesheet" href="{{ '/assets/homepage.css' | url }}?v={{ buildVersion }}">{% endif %}
<script type="module">
  import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm'
  window.supabase = createClient(
    'https://bnfvhyubidngrdykilhd.supabase.co',
    'sb_publishable_CjAaSwF06jtgDZDrYk_4vg_ssVTXjjx'
  )
</script>
</head>
<body>
<nav class="site-nav">
  <a class="nav-logo" href="{% if person %}https://mastersofsight.com/{% else %}{{ '/' | url }}{% endif %}">Masters of Sight</a>
  {% if person %}
  <span class="nav-profile-name">{{ person.name }}</span>
  {% else %}
  <span class="nav-profile-name" id="nav-profile-name"></span>
  {% endif %}
</nav>

<button class="mos-trigger" id="mosTrigger" aria-label="Open menu" aria-expanded="false">
  <span class="mos-trigger-line"></span>
  <span class="mos-trigger-line"></span>
  <span class="mos-trigger-line"></span>
</button>

<div class="mos-overlay" id="mosOverlay" role="dialog" aria-modal="true" aria-label="Site navigation">

  <div class="mos-backdrop" id="mosBackdrop"></div>

  <div class="mos-panel">

    <nav class="mos-nav" aria-label="Site navigation">
      <button class="mos-nav-item" data-target="about" aria-expanded="false">
        <span class="mos-nav-label">About Masters Of Sight</span>
        <span class="mos-nav-arrow">→</span>
      </button>
      <button class="mos-nav-item" data-target="why" aria-expanded="false">
        <span class="mos-nav-label">Why This Was Created</span>
        <span class="mos-nav-arrow">→</span>
      </button>
      <button class="mos-nav-item" data-target="contact" aria-expanded="false">
        <span class="mos-nav-label">Get in Touch</span>
        <span class="mos-nav-arrow">→</span>
      </button>
      <button class="mos-nav-item" data-target="instagram" aria-expanded="false">
        <span class="mos-nav-label">Social</span>
        <span class="mos-nav-arrow">→</span>
      </button>
      <button class="mos-nav-item" data-target="resources" aria-expanded="false">
        <span class="mos-nav-label">The Reference</span>
        <span class="mos-nav-arrow">→</span>
      </button>
      <button class="mos-nav-item" data-target="frame" aria-expanded="false">
        <span class="mos-nav-label">Stay in the Frame</span>
        <span class="mos-nav-arrow">→</span>
      </button>
    </nav>

    <div class="mos-divider" aria-hidden="true"></div>

    <div class="mos-content">

      <div class="mos-placeholder" id="mosPlaceholder">
        <p class="mos-placeholder-wordmark">Masters of Sight</p>
        <p class="mos-placeholder-hint">← Select a section</p>
      </div>

      <div class="mos-content-inner" id="panel-about">
        <h2 class="mos-content-heading">About Masters Of Sight</h2>
        <p class="mos-content-body">Masters Of Sight is a curated sanctuary for the visually obsessed. A place where craft is worshipped, where every frame is a deliberate act, and where the boundary between art and entertainment ceases to exist. This is not a portfolio. This is a resource for those who demand better.</p>
      </div>

      <div class="mos-content-inner" id="panel-why">
        <h2 class="mos-content-heading">Why This Was Created</h2><p class="mos-content-body">I built this because the world is drowning in content and forgetting what vision actually looks like. Consider this a reminder.</p><p class="mos-content-body" style="margin-top: 16px;">My name is Benny Jackson. I built this on my own time, with my own taste, because no one was going to build it for me. That's kind of the whole point.</p><p class="mos-content-body" style="margin-top: 16px;">For the ones who can't look away from great work. You know who you are.</p>
      </div>

      <div class="mos-content-inner" id="panel-contact">
        <h2 class="mos-content-heading">Get in Touch</h2><p class="mos-content-body">Have a project worth making? A collaboration worth exploring? A piece of work you think belongs here? I want to hear from you.</p><p class="mos-content-body" style="margin-top: 16px; color: rgba(232,224,208,0.7); font-size: 13px; letter-spacing: 0.04em;">Benny Jackson. Founder, Masters Of Sight.</p><a href="mailto:hello@mastersofsight.com" class="mos-content-link">hello@mastersofsight.com <span>→</span></a>
      </div>

      <div class="mos-content-inner" id="panel-instagram">
        <p class="mos-content-body">Instagram / Threads</p>
        <a href="https://instagram.com/mastersofsight" target="_blank" rel="noopener noreferrer" class="mos-content-link" style="color: var(--accent); border-color: rgba(201,169,110,0.3); margin-top: 8px;">
          @mastersofsight <span>→</span>
        </a>
        <p class="mos-content-body" style="margin-top: 20px;">YouTube</p>
        <a href="https://www.youtube.com/@mastersofsight" target="_blank" rel="noopener noreferrer" class="mos-content-link" style="color: var(--accent); border-color: rgba(201,169,110,0.3); margin-top: 8px;">
          @mastersofsight <span>→</span>
        </a>
      </div>

      <div class="mos-content-inner" id="panel-resources">
        <h2 class="mos-content-heading">The Reference</h2>
        <p class="mos-content-body" style="color: rgba(232,224,208,0.35); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 28px;">The sites we keep open in the other tab.</p>
        <p class="mos-content-body" style="margin-bottom: 4px;">Eyecandy</p>
        <p class="mos-content-body" style="color: rgba(232,224,208,0.35); font-size: 13px; margin-bottom: 16px;">The deepest searchable database of motion design and visual inspiration on the internet. If it moved beautifully, it's probably in here.</p>
        <a href="https://eyecannndy.com" target="_blank" rel="noopener noreferrer" class="mos-content-link" style="margin-top: 0; margin-bottom: 32px;">
          eyecannndy.com <span>→</span>
        </a>
        <p class="mos-content-body" style="margin-bottom: 4px;">Shotdeck</p>
        <p class="mos-content-body" style="color: rgba(232,224,208,0.35); font-size: 13px; margin-bottom: 16px;">The definitive film still library. Searchable by color, mood, lens, and lighting. Essential for anyone who thinks in frames.</p>
        <a href="https://shotdeck.com" target="_blank" rel="noopener noreferrer" class="mos-content-link" style="margin-top: 0; margin-bottom: 32px;">
          shotdeck.com <span>→</span>
        </a>
        <p class="mos-content-body" style="margin-bottom: 4px; margin-top: 8px;">The Art of End Cards</p>
        <p class="mos-content-body" style="color: rgba(232,224,208,0.35); font-size: 13px; margin-bottom: 16px;">A curated collection of advertising end cards.</p>
        <a href="https://theartofendcards.com" target="_blank" rel="noopener noreferrer" class="mos-content-link" style="margin-top: 0;">
          theartofendcards.com <span>→</span>
        </a>
      </div>

      <div class="mos-content-inner" id="panel-frame">
        <h2 class="mos-content-heading">Stay in the Frame</h2>
        <p class="mos-content-body">The archive is just the beginning. Full Frame is coming. A deeper room for the people who don't just browse. Be the first to know.</p>
        <a href="https://mastersofsight.substack.com/subscribe" target="_blank" rel="noopener noreferrer" class="mos-content-link">
          Count me in <span>→</span>
        </a>
      </div>

    </div>

    <span class="mos-wordmark">Masters of Sight</span>

  </div>
</div>

{% if person %}
<a class="profile-back" id="profile-back-link">← Back</a>
<script>
(function () {
  var from = new URLSearchParams(window.location.search).get('from');
  var link = document.getElementById('profile-back-link');
  if (link) link.href = from ? '/?discipline=' + from : '/';
})();
</script>
{% endif %}

{{ content | safe }}
</body>
</html>
