---
layout: base.njk
title: Saved — Masters Of Sight
homepageCss: true
---

<script>
  window.PEOPLE = {{ people | dump | safe }};
  window.SITE_BASE_URL = "{{ '/' | url }}";
</script>

<div class="hero saved-hero">
  <h1 class="mos-content-heading">Your Board</h1>
  <p class="saved-message">The masters worth remembering, kept in one place. The archive keeps growing, worth a look back now and then.</p>
</div>

<div class="saved-state" id="saved-logged-out-state" hidden>
  <p class="saved-message">Sign in to see your saved masters</p>
  <button class="filter-btn" id="savedSignInBtn" onclick="document.getElementById('mosAuthModal').style.display='flex'">Sign In</button>
</div>

<div class="saved-state" id="saved-empty-state" hidden>
  <p class="saved-message">You haven't saved anyone yet — browse the archive to start building your list.</p>
  <a class="saved-state-link" href="{{ '/' | url }}">Browse the archive →</a>
</div>

<div class="saved-state" id="saved-error-state" hidden>
  <p class="saved-message">We couldn't load your saved masters. Please refresh the page to try again.</p>
</div>

{% set savedSections = [
  { discipline: "Director", slug: "director", label: "Directors" },
  { discipline: "Cinematographer", slug: "cinematographer", label: "Cinematographers" },
  { discipline: "Photographer", slug: "photographer", label: "Photographers" },
  { discipline: "Designer", slug: "designer", label: "Designers" },
  { discipline: "Dream Makers", slug: "dream-makers", label: "Dream Makers" },
  { discipline: "Editor", slug: "editor", label: "Editors" },
  { discipline: "Colorist", slug: "colorist", label: "Colorists" }
] %}

<div class="saved-sections" id="saved-sections" hidden>
  <p class="saved-total" id="saved-total">All Saved (<span id="saved-total-count">0</span>)</p>
  {% for section in savedSections %}
  <section class="saved-section" data-discipline="{{ section.discipline }}">
    <h2 class="saved-section-heading">{{ section.label }}</h2>
    <div class="grid saved-section-grid" id="saved-grid-{{ section.slug }}"></div>
    <p class="saved-section-empty" hidden>No saved entries yet</p>
  </section>
  {% endfor %}
</div>

<div class="saved-danger-zone" id="savedDangerZone" hidden>
  <button class="saved-delete-link" id="savedDeleteAccountBtn">Delete my account</button>
</div>
