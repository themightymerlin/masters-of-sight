---
pagination:
  data: people
  size: 1
  alias: person
permalink: "masters/{{ person.id }}/index.html"
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ person.name }} — Masters Of Sight</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@900&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/profile.css' | url }}">
</head>
<body>

<script>
  window._galleryMediaRaw = {{ (person.galleryMedia or []) | dump | safe }};
  window._galleryImagesRaw = {{ (person.galleryImages or []) | dump | safe }};
</script>

<!-- ── VIDEO LIGHTBOX OVERLAY ── -->
<div id="lightbox-overlay" onclick="closeLightbox()" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.88); z-index:1000; align-items:center; justify-content:center;"></div>

<!-- ── LIGHTBOX ── -->
<div class="lightbox" id="lightbox" onclick="closeLightbox(event)">
  <button class="lightbox-close" onclick="closeLightbox()">&#215;</button>
  <button class="lightbox-nav lightbox-prev" onclick="lightboxNav(-1); event.stopPropagation()">&#8249;</button>
  <img class="lightbox-img" id="lightbox-img" src="" alt="">
  <button class="lightbox-nav lightbox-next" onclick="lightboxNav(1); event.stopPropagation()">&#8250;</button>
  <span class="lightbox-counter" id="lightbox-counter"></span>
</div>

{% set linkTypeConfig = {
  watch:   { label: "Watch", icon: "▶" },
  play:    { label: "Play", icon: "◈" },
  book:    { label: "Get the Book", icon: "○" },
  gallery: { label: "View Gallery", icon: "◻" },
  read:    { label: "Read", icon: "◇" },
  listen:  { label: "Listen", icon: "◎" }
} %}

<nav class="site-nav">
  <a class="nav-logo" href="https://mastersofsight.com/">Masters of Sight</a>
  <span class="nav-profile-name">{{ person.name }}</span>
</nav>

<button class="mos-trigger" aria-label="Open menu" aria-expanded="false">
  <span class="mos-trigger-line"></span>
  <span class="mos-trigger-line"></span>
  <span class="mos-trigger-line"></span>
</button>

<a class="profile-back" href="https://mastersofsight.com/">← Back</a>

<div class="profile-hero">
  <img class="profile-hero-img" src="{{ person.heroImage or person.coverImage }}" alt="{{ person.name }}">
  <div class="profile-hero-gradient"></div>
  <div class="profile-hero-content">
    <p class="profile-eyebrow">{{ person.discipline | displayDiscipline(person.entityType) }}</p>
    <h1 class="profile-name">{{ person.name }}</h1>
    <div class="profile-tags">
      <span class="tag">{{ person.style }}</span>
      <span class="tag">{{ person.nationality }}</span>
      <span class="tag">{% if person.died %}{{ person.born }} - {{ person.died }}{% else %}{{ person.born }}{% endif %}</span>
    </div>
  </div>
</div>

<div class="profile-body">
  <p class="profile-bio">{{ person.bio }}</p>

  <div class="profile-main">
    <div class="profile-section">
      <p class="profile-section-label">Signature Traits</p>
      <ul class="profile-traits">
        {% for trait in person.traits %}
        <li>{{ trait }}</li>
        {% endfor %}
      </ul>
    </div>

    <div class="profile-section">
      <p class="profile-section-label">Major Works</p>
      <ul class="profile-works">
        {% for work in person.works %}
        <li>
          <p class="work-title">{{ work.title }}</p>
          <p class="work-desc">{{ work.desc }}</p>
          {% if work.links and work.links.length %}
          <div class="work-links">
            {% for link in work.links %}
            {% set cfg = linkTypeConfig[link.type] %}
            <a class="work-link work-link--{{ link.type }}" href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ cfg.icon if cfg else "→" }} {{ cfg.label if cfg else link.type }}</a>
            {% endfor %}
          </div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="profile-sidebar">
    <div class="profile-gallery">
      {% if person.galleryMedia and person.galleryMedia.length %}
        {% for item in person.galleryMedia %}
          {% if item.type == "image" or item.type == "gif" %}
          <img src="{{ item.src }}" alt="{{ person.name }}">
          {% endif %}
        {% endfor %}
      {% else %}
        {% for src in person.galleryImages %}
        <img src="{{ src }}" alt="{{ person.name }}">
        {% endfor %}
      {% endif %}
    </div>

    {% if person.galleryMedia and person.galleryMedia.length %}
    <div id="p-video-bookend">
      {% for item in person.galleryMedia %}
        {% if item.type == "video" %}
        <div class="video-bookend" onclick="openVideoLightbox('{{ item.youtubeId }}')">
          <div class="video-bookend-thumb">
            <img src="{{ item.thumb }}" alt="{{ item.caption or (person.name + ' video') }}" loading="lazy" onerror="this.src='https://img.youtube.com/vi/{{ item.youtubeId }}/hqdefault.jpg'">
            <div class="video-bookend-overlay">
              <div class="video-bookend-play">
                <svg viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              {% if item.caption %}<div class="video-bookend-caption">{{ item.caption }}</div>{% endif %}
            </div>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}

    <div class="sidebar-meta">
      <div class="meta-row">
        <span class="meta-label">Discipline</span>
        <span class="meta-value">{{ person.discipline | displayDiscipline(person.entityType) }}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">Style</span>
        <span class="meta-value">{{ person.style }}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">{% if person.entityType == "duo" %}Formed{% elif person.entityType == "studio" %}Founded{% else %}Born{% endif %}</span>
        <span class="meta-value">{% if person.died %}{{ person.born }} - {{ person.died }}{% else %}{{ person.born }}{% endif %}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">Nationality</span>
        <span class="meta-value">{{ person.nationality }}</span>
      </div>
      {% if person.url %}
      <div class="meta-row">
        <span class="meta-label">Learn more</span>
        <a class="meta-link" href="{{ person.url }}" target="_blank">View profile →</a>
      </div>
      {% endif %}
    </div>
  </div>
</div>

<div class="related-masters">
  <p class="related-masters-label">If you like {{ person.name }}, you will like these masters</p>
  <div class="related-masters-grid">
    {% for relatedId in person.related %}
      {% for candidate in people %}
        {% if candidate.id == relatedId %}
        <div class="related-card">
          <img class="related-card-img" src="{{ candidate.coverImage }}" alt="{{ candidate.name }}">
          <div class="related-card-info">
            <p class="related-card-discipline">{{ candidate.discipline | displayDiscipline(candidate.entityType) }}</p>
            <p class="related-card-name">{{ candidate.name }}</p>
          </div>
        </div>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</div>

<script>
(function () {
  var navName = document.querySelector('.nav-profile-name');
  var navLogo = document.querySelector('.nav-logo');
  var hero = document.querySelector('.profile-hero');

  var handleScroll = function () {
    var threshold = hero ? hero.getBoundingClientRect().bottom + window.scrollY - 64 : 300;
    var visible = window.scrollY > threshold;
    navName.classList.toggle('is-visible', visible);
    navLogo.classList.toggle('nav-logo--hidden', visible);
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
})();
</script>

<script>
(function () {
  var mediaItems = [];
  if (window._galleryMediaRaw && window._galleryMediaRaw.length) {
    mediaItems = window._galleryMediaRaw.filter(function (m) {
      if (m.type === 'image' || m.type === 'gif') return m.src && m.src.trim() !== '';
      if (m.type === 'video') return m.youtubeId && m.youtubeId.trim() !== '';
      return false;
    });
  } else {
    var imgs = (window._galleryImagesRaw || []).filter(function (src) { return src && src.trim() !== ''; });
    mediaItems = imgs.map(function (src) { return { type: 'image', src: src }; });
  }
  window._lightboxMedia = mediaItems;

  var _lbIndex = 0;

  window.openVideoLightbox = function (youtubeId) {
    var overlay = document.getElementById('lightbox-overlay');
    overlay.style.display = 'flex';
    overlay.innerHTML =
      '<div class="lightbox-video-wrap" onclick="event.stopPropagation()">' +
        '<iframe src="https://www.youtube.com/embed/' + youtubeId + '?autoplay=1&rel=0" allow="autoplay; fullscreen" allowfullscreen frameborder="0"></iframe>' +
        '<button class="lightbox-close-btn" onclick="closeLightbox()">✕</button>' +
      '</div>';
    document.addEventListener('keydown', function onEsc(e) { if (e.key === 'Escape') closeLightbox(); }, { once: true });
  };

  window.openLightbox = function (index) {
    var media = window._lightboxMedia || [];
    if (!media.length) return;
    _lbIndex = index;
    updateLightbox();
    document.getElementById('lightbox').classList.add('active');
    document.body.style.overflow = 'hidden';
  };

  function updateLightbox() {
    var media = window._lightboxMedia || [];
    var item = media[_lbIndex];
    var lb = document.getElementById('lightbox');

    var existing = lb.querySelector('.lightbox-img, .lightbox-iframe-wrap');
    if (existing) existing.remove();

    var closeBtn = lb.querySelector('.lightbox-close');

    if (item.type === 'video') {
      var wrap = document.createElement('div');
      wrap.className = 'lightbox-iframe-wrap';
      wrap.innerHTML = '<iframe src="https://www.youtube.com/embed/' + item.youtubeId + '?autoplay=1&mute=0&rel=0&modestbranding=1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
      closeBtn.after(wrap);
    } else {
      var img = document.createElement('img');
      img.className = 'lightbox-img';
      img.id = 'lightbox-img';
      img.src = item.src;
      img.style.transform = 'scale(0.96)';
      setTimeout(function () { img.style.transform = ''; }, 10);
      closeBtn.after(img);
    }

    document.getElementById('lightbox-counter').textContent = (_lbIndex + 1) + ' / ' + media.length;
    document.querySelector('.lightbox-prev').style.opacity = media.length > 1 ? '1' : '0';
    document.querySelector('.lightbox-next').style.opacity = media.length > 1 ? '1' : '0';
  }

  window.lightboxNav = function (dir) {
    var media = window._lightboxMedia || [];
    _lbIndex = (_lbIndex + dir + media.length) % media.length;
    updateLightbox();
  };

  window.closeLightbox = function (e) {
    if (e && e.target !== e.currentTarget && !e.target.classList.contains('lightbox-close') && !e.target.classList.contains('lightbox-close-btn')) return;
    document.getElementById('lightbox').classList.remove('active');
    var overlay = document.getElementById('lightbox-overlay');
    overlay.style.display = 'none';
    overlay.innerHTML = '';
    document.body.style.overflow = '';
  };

  document.addEventListener('keydown', function (e) {
    var lb = document.getElementById('lightbox');
    if (!lb.classList.contains('active')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') lightboxNav(-1);
    if (e.key === 'ArrowRight') lightboxNav(1);
  });

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.profile-gallery img').forEach(function (img, i) {
      img.dataset.index = i;
      img.addEventListener('click', function () { openLightbox(i); });
    });
  });
})();
</script>

</body>
</html>
